# Email: leave SMTP_HOST empty to print emails to the log instead of sending them
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=InSight <no-reply@insight.towera.sg>
SMTP_STARTTLS=true
