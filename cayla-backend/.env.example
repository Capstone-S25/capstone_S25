DATABASE_URL=postgresql://cctv:cctv@localhost:5433/cctv
SESSION_HOURS=12
COOKIE_SECURE=false        # true in production (https only)
SITE_TZ=Asia/Singapore
TEMP_PASSWORD_HOURS=168                 # 7 days
APP_NAME=InSight
SITE_NAME=Tower A                        # "...added you to InSight for Tower A"
