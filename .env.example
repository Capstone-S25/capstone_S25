# Relative paths resolve against the application checkout.
VISION_MODELS_DIR=models
VISION_RUNTIME_DIR=runtime

# Optional: serve a compatible Gemma model separately; include /v1.
# GEMMA_BASE_URL=http://127.0.0.1:8080/v1
# GEMMA_MODEL=gemma4-26b-a4b
# GEMMA_API_KEY=
# Set by setup when the transfer bundle carries Gemma for this machine's CPU:
# GEMMA_LOCAL=1                  # deploy.py start launches gemma/llama/llama-server
# GEMMA_LOCAL_THREADS=           # default: half the CPU cores
# GEMMA_TIMEOUT_S=300            # read timeout per request (default 110)
# GEMMA_MAX_WAIT_S=900           # how long a queued review may wait (default 120)
# Which windows Gemma reviews: flagged (default) or all; and at most one review
# per task and camera in this many seconds of video.
# GEMMA_CONFIRM=flagged
# GEMMA_CONFIRM_INTERVAL_S=30

# Required only for recording / RTSP backend, not file uploads.
# DATABASE_URL=postgresql+psycopg://capstone:password@127.0.0.1:5432/capstone
